# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude Code
.claude/

# Le projet est en yarn (packageManager le declare) : un package-lock.json
# decrit un arbre de dependances qui n'est pas celui qui part en production,
# et fait mentir tout audit lance dessus.
package-lock.json

# Yarn Berry (v3+)
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Yarn PnP
.pnp.*
.pnp
# Manifeste interne du Hub — lu sur le disque, pas versionné ici : ce dépôt
# est public, et le manifeste décrit des équipes et des choix qui ne le sont
# pas. Une copie de secours vit dans le dépôt privé Hub-App.
/hub.yaml
